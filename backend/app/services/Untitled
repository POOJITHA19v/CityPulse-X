
import json
from urllib.parse import urlencode
from urllib.request import Request, urlopen


GEOCODING_URL = "https://geocoding-api.open-meteo.com/v1/search"
FORECAST_URL = "https://api.open-meteo.com/v1/forecast"


def fetch_json(url, params):
    """Fetch JSON data from a weather API."""
    full_url = url + "?" + urlencode(params)

    request = Request(
        full_url,
        headers={"User-Agent": "CityPulse-X/1.0"}
    )

    with urlopen(request, timeout=15) as response:
        return json.loads(response.read().decode("utf-8"))


def fetch_live_weather(city: str) -> dict:
    """Fetch weather data for a city using Open-Meteo."""

    city = city.strip()

    if not city:
        raise ValueError("Please enter a city name.")

    # 1. Find the city's geographical coordinates.
    locations = fetch_json(
        GEOCODING_URL,
        {
            "name": city,
            "count": 1,
            "language": "en",
            "format": "json"
        }
    )

    results = locations.get("results", [])

    if not results:
        raise ValueError(
            f"Could not find the city '{city}'. "
            "Check the spelling and try again."
        )

    location = results[0]

    latitude = location["latitude"]
    longitude = location["longitude"]

    # 2. Request current weather and hourly storm probabilities.
    weather = fetch_json(
        FORECAST_URL,
        {
            "latitude": latitude,
            "longitude": longitude,
            "current": (
                "temperature_2m,"
                "relative_humidity_2m,"
                "precipitation,"
                "rain,"
                "wind_speed_10m,"
                "wind_gusts_10m,"
                "weather_code"
            ),
            "hourly": (
                "precipitation_probability,"
                "thunderstorm_probability"
            ),
            "forecast_hours": 1,
            "timezone": "auto"
        }
    )

    current = weather.get("current", {})
    hourly = weather.get("hourly", {})

    def first_hour(variable):
        values = hourly.get(variable, [])
        if values and values[0] is not None:
            return float(values[0])
        return 0.0

    thunderstorm_probability = (
        first_hour("thunderstorm_probability") / 100.0
    )

    # These are inputs for the existing demonstration risk engine.
    # Thunderstorm probability is a proxy, not a lightning measurement.
    return {
        "city": location.get("name", city),
        "country": location.get("country", ""),
        "latitude": latitude,
        "longitude": longitude,
        "time": current.get("time"),
        "temperature_c": current.get("temperature_2m"),
        "humidity_percent": current.get("relative_humidity_2m"),
        "rainfall_mm": float(current.get("precipitation") or 0),
        "wind_speed_kmh": float(
            current.get("wind_speed_10m") or 0
        ),
        "wind_gusts_kmh": float(
            current.get("wind_gusts_10m") or 0
        ),
        "lightning_probability": thunderstorm_probability,
        "thunderstorm_intensity": thunderstorm_probability,
        "thunderstorm_probability_percent": (
            thunderstorm_probability * 100
        ),
        "precipitation_probability_percent": (
            first_hour("precipitation_probability")
        ),
        "weather_code": current.get("weather_code"),
        "source": "Open-Meteo",
        "data_type": "Weather model current estimate and forecast"
    }